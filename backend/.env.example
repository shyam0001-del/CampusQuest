# CampusQuest Backend Environment Variables

PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local Connection String
# Required in production: will NOT fall back to localhost if NODE_ENV=production
# Example Atlas connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/campusquest?retryWrites=true&w=majority

# JWT Authentication
# In production, specify a secure random string at least 32 characters long
JWT_SECRET=campusquest_production_secure_jwt_secret_change_me_in_prod
JWT_EXPIRES_IN=7d

# Allowed Frontend URL for CORS (e.g., https://campusquest.vercel.app)
FRONTEND_URL=http://localhost:5173

# Local File Uploads Directory
UPLOAD_DIR=uploads

# Reverse Proxy Trust Configuration
# When running behind 1 reverse proxy (Render, Vercel, Railway, Nginx, Cloudflare, AWS ALB),
# set to '1' (or hop count). In local development, defaults to 'loopback'.
# Set to 'false' if connecting directly without any reverse proxy.
# Never set blindly to 'true' as that trusts spoofed client headers.
TRUST_PROXY=1

# Optional: Initial Administrator Provisioning via Environment Variables
# Used by 'npm run bootstrap:admin' if CLI arguments are omitted
# ADMIN_EMAIL=admin@university.edu
# ADMIN_PASSWORD=ChangeThisSecureAdminPassword123!
# ADMIN_NAME="System Administrator"
