# Dependencies
node_modules
*/node_modules

# Build Outputs
dist
backend/dist
frontend/dist

# Environment variables & secrets (preserve examples)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# OS & Logs
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploads & User generated content
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
